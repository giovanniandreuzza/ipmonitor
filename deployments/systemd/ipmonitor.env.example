# IP Monitor Environment Configuration
# Copy this file to /etc/default/ipmonitor and update with your values
# sudo cp ipmonitor.env.example /etc/default/ipmonitor
# sudo chmod 600 /etc/default/ipmonitor

# Required: Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Required: Your Telegram chat ID from @userinfobot
TELEGRAM_CHAT_ID=123456789

# Optional: Log level (DEBUG, INFO, WARN, ERROR)
# Default: INFO
LOG_LEVEL=INFO
